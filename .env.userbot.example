# Application
APP_NAME=go-little-userbot-maker
APP_ENV=development

# Orchestrator service
ORCH_LISTEN_ADDR=:8080
ORCH_SECRET_KEY=replace-with-secret-key
ORCH_HEALTH_INTERVAL=30s
ORCH_MAX_WORKERS=64
ORCH_BOOTSTRAP_DELAY=2s
ORCH_ENABLE_MOCK=true

# Database
DB_URL=postgres://userbot:userbot@localhost:5432/little_userbot?sslmode=disable
DB_MAX_CONNS=10
DB_MAX_IDLE=5
DB_MAX_LIFE=30m

# Security
SEC_SESSION_SALT=replace-with-random-string