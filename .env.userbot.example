# Application
APP_NAME=go-little-userbot-maker
APP_ENV=development

# Logging
LOG_LEVEL=debug
LOG_JSON=true

# Orchestrator service
ORCH_LISTEN_ADDR=:8080
ORCH_METRICS_ADDR=:9090
ORCH_SECRET_KEY=replace-with-secret-key
ORCH_HEALTH_INTERVAL=30s
ORCH_MAX_WORKERS=64
ORCH_BOOTSTRAP_DELAY=2s
ORCH_ENABLE_MOCK=true

# Database
DB_URL=postgres://userbot:userbot@localhost:5432/little_userbot?sslmode=disable
DB_MAX_CONNS=10
DB_MAX_IDLE=5
DB_MAX_LIFE=30m

# Redis
REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=15m

# Telemetry
TEL_PROM_ENABLED=true
TEL_TRACE_ENDPOINT=
TEL_TRACE_SAMPLE_RATE=0.05

# Security
SEC_SESSION_SALT=replace-with-random-string
