# Application
APP_NAME=go-little-userbot-maker
APP_ENV=development

# Wizard service
WIZARD_BOT_TOKEN=replace-with-telegram-bot-token
WIZARD_API_ID=replace-with-api-id
WIZARD_API_HASH=replace-with-api-hash
WIZARD_LISTEN_ADDR=:8081
WIZARD_ORCHESTRATOR_URL=http://localhost:8080
WIZARD_STORAGE_PATH=./storage/logs/wizard
WIZARD_STATE_TTL=10m
WIZARD_ADMIN_IDS=
WIZARD_USE_MOCK=true
WIZARD_DEBUG=true
